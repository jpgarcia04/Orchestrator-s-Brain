{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orchestrator's Brain",
  "version": "0.0.3",
  "identifier": "dev.obrain.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orchestrator's Brain",
        "width": 1180,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#05070c",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0OTkyMjRFOTYxMjVFMjEKUldRaFhoS1dUaUtaTkJUMnNXaFFRU2ZXUEZrRFA2N1M4Q1U3ZmV3K1FZN0tISGpwOWxOa255cGcK",
      "endpoints": [
        "https://github.com/jpgarcia04/Orchestrator-s-Brain/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
